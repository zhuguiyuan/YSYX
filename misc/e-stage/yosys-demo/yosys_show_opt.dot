digraph "counter" {
label="counter";
rankdir="LR";
remincross=true;
n2 [ shape=octagon, label="count", color="black", fontcolor="black"];
n3 [ shape=octagon, label="en", color="black", fontcolor="black"];
n4 [ shape=octagon, label="rst", color="black", fontcolor="black"];
n5 [ shape=octagon, label="clk", color="black", fontcolor="black"];
c11 [ shape=record, label="{{<p6> CLK|<p7> D|<p8> EN|<p9> SRST}|$10\n$sdffe|{<p10> Q}}",  ];
v0 [ label="2'01" ];
c15 [ shape=record, label="{{<p12> A|<p13> B}|$2\n$add|{<p14> Y}}",  ];
c15:p14:e -> c11:p7:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
c11:p10:e -> n2:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n2:e -> c15:p12:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
n3:e -> c11:p8:w [color="black", fontcolor="black", label=""];
n4:e -> c11:p9:w [color="black", fontcolor="black", label=""];
n5:e -> c11:p6:w [color="black", fontcolor="black", label=""];
v0:e -> c15:p13:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
}
